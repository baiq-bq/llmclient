{
  "name": "@baiq/llmclient",
  "version": "0.3.0",
  "description": "Configurable multi-provider LLM client with usage accounting, pricing overrides, tools and streaming",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiq-bq/llmclient.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./providers/openai": {
      "import": {
        "types": "./dist/providers/openai.d.ts",
        "default": "./dist/providers/openai.js"
      },
      "require": {
        "types": "./dist/providers/openai.d.cts",
        "default": "./dist/providers/openai.cjs"
      }
    },
    "./providers/anthropic": {
      "import": {
        "types": "./dist/providers/anthropic.d.ts",
        "default": "./dist/providers/anthropic.js"
      },
      "require": {
        "types": "./dist/providers/anthropic.d.cts",
        "default": "./dist/providers/anthropic.cjs"
      }
    },
    "./providers/google": {
      "import": {
        "types": "./dist/providers/google.d.ts",
        "default": "./dist/providers/google.js"
      },
      "require": {
        "types": "./dist/providers/google.d.cts",
        "default": "./dist/providers/google.cjs"
      }
    },
    "./providers/xai": {
      "import": {
        "types": "./dist/providers/xai.d.ts",
        "default": "./dist/providers/xai.js"
      },
      "require": {
        "types": "./dist/providers/xai.d.cts",
        "default": "./dist/providers/xai.cjs"
      }
    },
    "./package.json": "./package.json",
    "./providers/deepseek": {
      "import": {
        "types": "./dist/providers/deepseek.d.ts",
        "default": "./dist/providers/deepseek.js"
      },
      "require": {
        "types": "./dist/providers/deepseek.d.cts",
        "default": "./dist/providers/deepseek.cjs"
      }
    },
    "./providers/kimi": {
      "import": {
        "types": "./dist/providers/kimi.d.ts",
        "default": "./dist/providers/kimi.js"
      },
      "require": {
        "types": "./dist/providers/kimi.d.cts",
        "default": "./dist/providers/kimi.cjs"
      }
    }
  },
  "publishConfig": {
    "registry": "https://europe-west1-npm.pkg.dev/baiq-459807/npm-private/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && node scripts/smoke.mjs",
    "prepack": "npm run build",
    "publish:private": "node scripts/publish.mjs",
    "check:private-install": "node scripts/install-check.mjs",
    "check:ci": "npm run typecheck && npm run build && node scripts/smoke.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "ai": "7.0.154",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/deepseek": "^3.0.74",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/xai": "^5.0.14",
    "@ai-sdk/moonshotai": "^3.0.79"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "@ai-sdk/deepseek": {
      "optional": true
    },
    "@ai-sdk/moonshotai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/deepseek": "3.0.74",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/moonshotai": "3.0.79",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/xai": "5.0.14",
    "@types/node": "^24.0.0",
    "semver": "7.8.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
